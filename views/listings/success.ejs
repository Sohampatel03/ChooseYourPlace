<% layout("/layouts/boilerplate") %>

<div class="bg-gray-50 min-h-screen flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-lg md:max-w-2xl bg-white rounded-2xl shadow-xl p-6 sm:p-8 text-center transform transition-all">

    <!-- Success Icon -->
    <div class="flex justify-center mb-6">
      <div class="w-16 h-16 sm:w-20 sm:h-20 bg-green-100 rounded-full flex items-center justify-center shadow-inner">
        <i class="fa-solid fa-check text-green-600 text-3xl sm:text-4xl"></i>
      </div>
    </div>

    <!-- Success Message -->
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-3">
      Reservation Confirmed!
    </h1>
    <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-8 px-2 sm:px-0">
      Your reservation for 
      <span class="font-semibold text-rose-500"><%= listing.title %></span> 
      has been successfully booked. We’ve also sent the confirmation details to your email.
    </p>

    <!-- Hotel Image -->
    <div class="mb-6">
      <img 
        src="<%= listing.image %>" 
        alt="<%= listing.title %>" 
        class="w-full h-48 sm:h-60 md:h-72 object-cover rounded-xl shadow-md hover:scale-[1.02] transition-transform"
      />
    </div>

    <!-- Back to Home -->
    <a 
      href="/listings" 
      class="inline-block w-full py-3 bg-rose-500 text-white font-medium rounded-lg hover:bg-rose-600 focus:ring-2 focus:ring-rose-300 transition-all duration-200 text-sm sm:text-base">
      <i class="fa-solid fa-house mr-2"></i> Back to Home
    </a>

    <!-- Booking Details -->
    <div class="mt-6 bg-gray-50 rounded-xl p-4 sm:p-5 text-left text-sm sm:text-base text-gray-700 border border-gray-100">
      <div class="space-y-2 sm:space-y-3">
        <p>
          <span class="font-medium text-gray-900">Location:</span> 
          <%= listing.location %>, <%= listing.country %>
        </p>
        <p>
          <span class="font-medium text-gray-900">Price:</span> 
          ₹<%= listing.price.toLocaleString("en-IN") %> / night
        </p>
        <p>
          <span class="font-medium text-gray-900">Hosted by:</span> 
          <%= listing.owner.username %>
        </p>
      </div>
    </div>

  </div>
</div>
