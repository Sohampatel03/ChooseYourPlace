<% layout("/layouts/boilerplate") %>

<div class="bg-gradient-to-b from-rose-50 to-white min-h-screen py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">List Your Property</h1>
      <p class="text-gray-600">Share your space with travelers from around the world</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <form action="/listings" method="POST" class="space-y-6 needs-validation" novalidate>
        
        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-semibold text-gray-700 mb-2">
            Property Title <span class="text-red-500">*</span>
          </label>
          <input 
            id="title" 
            name="title" 
            type="text" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent transition"
            placeholder="Cozy Beachfront Cottage" 
            required
          />
          <p class="mt-1 text-sm text-gray-500">Choose a catchy title that describes your place</p>
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
            Description <span class="text-red-500">*</span>
          </label>
          <textarea 
            id="description" 
            name="description" 
            rows="5" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent resize-none transition"
            placeholder="Tell guests what makes your place special..."
            required
          ></textarea>
          <p class="mt-1 text-sm text-gray-500">Highlight unique features and amenities</p>
        </div>

        <!-- Price and Location Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Price -->
          <div>
            <label for="price" class="block text-sm font-semibold text-gray-700 mb-2">
              Price per Night (₹) <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-4 top-3 text-gray-500 font-medium">₹</span>
              <input 
                id="price" 
                name="price" 
                type="number" 
                min="0"
                class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent transition"
                placeholder="1500" 
                required
              />
            </div>
          </div>

          <!-- Location -->
          <div>
            <label for="location" class="block text-sm font-semibold text-gray-700 mb-2">
              Location <span class="text-red-500">*</span>
            </label>
            <input 
              id="location" 
              name="location" 
              type="text" 
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent transition"
              placeholder="Malibu" 
              required
            />
          </div>
        </div>

        <!-- Country -->
        <div>
          <label for="country" class="block text-sm font-semibold text-gray-700 mb-2">
            Country <span class="text-red-500">*</span>
          </label>
          <input 
            id="country" 
            name="country" 
            type="text" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent transition"
            placeholder="United States" 
            required
          />
        </div>

        <!-- Image URL -->
        <div>
          <label for="image" class="block text-sm font-semibold text-gray-700 mb-2">
            Image URL
          </label>
          <input 
            id="image" 
            name="image" 
            type="url" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent transition"
            placeholder="https://example.com/image.jpg"
          />
          <p class="mt-1 text-sm text-gray-500">Leave blank to use default image</p>
        </div>

        <!-- Image Preview (Optional Enhancement) -->
        <div id="imagePreview" class="hidden">
          <p class="text-sm font-semibold text-gray-700 mb-2">Image Preview</p>
          <img id="previewImg" class="w-full h-48 object-cover rounded-lg border border-gray-300" alt="Preview"/>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button 
            type="submit" 
            class="w-full px-6 py-4 bg-rose-500 text-white font-semibold rounded-lg hover:bg-rose-600 transition-all duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
          >
            <i class="fa-solid fa-plus mr-2"></i>
            Create Listing
          </button>
        </div>

        <!-- Help Text -->
        <p class="text-center text-sm text-gray-500 pt-2">
          <span class="text-red-500">*</span> Required fields
        </p>
      </form>
    </div>

    <!-- Info Box -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-xl p-6">
      <div class="flex items-start space-x-3">
        <i class="fa-solid fa-info-circle text-blue-500 text-xl mt-0.5"></i>
        <div>
          <h3 class="font-semibold text-blue-900 mb-1">Tips for a great listing</h3>
          <ul class="text-sm text-blue-800 space-y-1">
            <li>• Use high-quality, well-lit photos</li>
            <li>• Write a detailed, honest description</li>
            <li>• Set competitive pricing for your area</li>
            <li>• Highlight unique amenities and features</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div