<% layout("/layouts/boilerplate") %>

<div class="bg-gray-50 min-h-screen py-8">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    
    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column - Property Details -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Image Section -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <img 
            src="<%= listing.image %>" 
            alt="<%= listing.title %>" 
            class="w-full h-96 object-cover"
          />
        </div>

        <!-- Title & Location -->
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            <%= listing.title %>
          </h1>
          
          <div class="flex items-center text-gray-600 mb-4">
            <i class="fa-solid fa-location-dot text-rose-500 mr-2"></i>
            <span class="text-lg"><%= listing.location %>, <%= listing.country %></span>
          </div>

          <div class="flex items-center space-x-2 bg-gray-50 rounded-lg px-4 py-3 w-fit">
            <i class="fa-solid fa-user text-gray-500"></i>
            <span class="text-sm text-gray-600">Hosted by</span>
            <span class="font-semibold text-gray-900"><%= listing.owner.username %></span>
          </div>
        </div>

        <!-- Description -->
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-3">About this place</h2>
          <p class="text-gray-700 leading-relaxed"><%= listing.description %></p>
        </div>

        <!-- Reviews Section -->
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-6">
            <i class="fa-solid fa-star text-yellow-500 mr-2"></i>
            Reviews (<%= listing.reviews.length %>)
          </h2>

          <!-- Review Form -->
          <% if(currUser) { %>
            <form method="POST" action="/listings/<%= listing._id %>/review" class="mb-8 p-4 bg-gray-50 rounded-xl">
              <h3 class="font-semibold text-gray-900 mb-4">Leave a review</h3>
              
              <div class="mb-4">
                <label for="rating" class="block text-sm font-medium text-gray-700 mb-2">
                  Rating: <span id="ratingValue" class="text-rose-500 font-bold">3</span>/5
                </label>
                <input 
                  type="range" 
                  min="1" 
                  max="5" 
                  value="3"
                  id="rating" 
                  name="rating" 
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-rose-500"
                  oninput="document.getElementById('ratingValue').textContent = this.value"
                />
              </div>

              <div class="mb-4">
                <label for="comment" class="block text-sm font-medium text-gray-700 mb-2">Comment</label>
                <textarea 
                  name="comment" 
                  id="comment" 
                  rows="4" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-transparent resize-none"
                  placeholder="Share your experience..."
                  required
                ></textarea>
              </div>

              <button type="submit" class="w-full px-4 py-3 bg-rose-500 text-white font-medium rounded-lg hover:bg-rose-600 transition-colors">
                Submit Review
              </button>
            </form>
          <% } else { %>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
              <p class="text-blue-800">
                <a href="/login" class="font-semibold underline hover:text-blue-600">Log in</a> to leave a review
              </p>
            </div>
          <% } %>

          <!-- Reviews List -->
          <div class="space-y-4">
            <% if(listing.reviews.length === 0) { %>
              <p class="text-gray-500 text-center py-8">No reviews yet. Be the first to review!</p>
            <% } %>
            
            <% for(let review of listing.reviews) { %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center space-x-2">
                    <div class="flex text-yellow-500">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <i class="fa-solid fa-star <%= i <= review.rating ? '' : 'opacity-30' %>"></i>
                      <% } %>
                    </div>
                    <span class="font-semibold text-gray-900"><%= review.rating %>/5</span>
                  </div>
                  
                  <form method="POST" action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE">
                    <button type="submit" class="text-red-500 hover:text-red-700 text-sm font-medium transition-colors">
                      <i class="fa-solid fa-trash mr-1"></i> Delete
                    </button>
                  </form>
                </div>
                
                <p class="text-gray-700"><%= review.author %></p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Column - Booking Card -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-24">
          <div class="mb-6">
            <div class="flex items-baseline space-x-2">
              <span class="text-3xl font-bold text-gray-900">₹<%= listing.price.toLocaleString("en-IN") %></span>
              <span class="text-gray-600">/ night</span>
            </div>
          </div>

          <!-- Owner Actions -->
          <% if(currUser && (currUser._id == listing.owner.id)) { %>
            <div class="space-y-3">
              <a href="/listings/<%= listing.id %>/edit" class="block w-full px-4 py-3 bg-yellow-500 text-white font-medium rounded-lg hover:bg-yellow-600 transition-colors text-center">
                <i class="fa-solid fa-edit mr-2"></i> Edit Listing
              </a>
              
              <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
                <button type="submit" class="w-full px-4 py-3 bg-red-500 text-white font-medium rounded-lg hover:bg-red-600 transition-colors">
                  <i class="fa-solid fa-trash mr-2"></i> Delete Listing
                </button>
              </form>

              <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-4">
                <p class="text-sm text-blue-800">
                  <i class="fa-solid fa-info-circle mr-1"></i> You are the owner of this listing
                </p>
              </div>
            </div>
          <% } else { %>
            <button class="w-full px-4 py-3 bg-rose-500 text-white font-medium rounded-lg hover:bg-rose-600 transition-colors">
              Reserve
            </button>
            <p class="text-center text-sm text-gray-500 mt-3">You won't be charged yet</p>
          <% } %>

          <!-- Property Highlights -->
          <div class="mt-6 pt-6 border-t border-gray-200 space-y-3">
            <div class="flex items-center text-gray-700">
              <i class="fa-solid fa-location-dot w-6 text-gray-400"></i>
              <span class="text-sm"><%= listing.location %></span>
            </div>
            <div class="flex items-center text-gray-700">
              <i class="fa-solid fa-globe w-6 text-gray-400"></i>
              <span class="text-sm"><%= listing.country %></span>
            </div>
            <div class="flex items-center text-gray-700">
              <i class="fa-solid fa-star w-6 text-gray-400"></i>
              <span class="text-sm"><%= listing.reviews.length %> reviews</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>