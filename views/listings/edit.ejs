<% layout("/layouts/boilerplate") %>

<div class="bg-gradient-to-b from-yellow-50 to-white min-h-screen py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
    
    <!-- Header -->
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Edit Your Listing</h1>
      <p class="text-gray-600">Update your property details to keep it fresh</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="space-y-6">
        
        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-semibold text-gray-700 mb-2">
            Property Title <span class="text-red-500">*</span>
          </label>
          <input 
            id="title" 
            name="title" 
            type="text" 
            value="<%= listing.title %>"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition"
            required
          />
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
            Description <span class="text-red-500">*</span>
          </label>
          <textarea 
            id="description" 
            name="description" 
            rows="5" 
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent resize-none transition"
            required
          ><%= listing.description %></textarea>
        </div>

        <!-- Price and Location Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Price -->
          <div>
            <label for="price" class="block text-sm font-semibold text-gray-700 mb-2">
              Price per Night (₹) <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-4 top-3 text-gray-500 font-medium">₹</span>
              <input 
                id="price" 
                name="price" 
                type="number" 
                value="<%= listing.price %>"
                min="0"
                class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition"
                required
              />
            </div>
          </div>

          <!-- Location -->
          <div>
            <label for="location" class="block text-sm font-semibold text-gray-700 mb-2">
              Location <span class="text-red-500">*</span>
            </label>
            <input 
              id="location" 
              name="location" 
              type="text" 
              value="<%= listing.location %>"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition"
              required
            />
          </div>
        </div>

        <!-- Country -->
        <div>
          <label for="country" class="block text-sm font-semibold text-gray-700 mb-2">
            Country <span class="text-red-500">*</span>
          </label>
          <input 
            id="country" 
            name="country" 
            type="text" 
            value="<%= listing.country %>"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition"
            required
          />
        </div>

        <!-- Image URL -->
        <div>
          <label for="image" class="block text-sm font-semibold text-gray-700 mb-2">
            Image URL <span class="text-red-500">*</span>
          </label>
          <input 
            id="image" 
            name="image" 
            type="url" 
            value="<%= listing.image %>"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-transparent transition"
            required
          />
        </div>

        <!-- Current Image Preview -->
        <div>
          <p class="text-sm font-semibold text-gray-700 mb-2">Current Image</p>
          <div class="border border-gray-300 rounded-lg overflow-hidden">
            <img 
              src="<%= listing.image %>" 
              alt="<%= listing.title %>" 
              class="w-full h-64 object-cover"
            />
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 px-6 py-4 bg-yellow-500 text-white font-semibold rounded-lg hover:bg-yellow-600 transition-all duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
          >
            <i class="fa-solid fa-save mr-2"></i>
            Update Listing
          </button>
          
          <a 
            href="/listings/<%= listing._id %>" 
            class="flex-1 px-6 py-4 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition-all duration-200 text-center"
          >
            <i class="fa-solid fa-times mr-2"></i>
            Cancel
          </a>
        </div>

        <!-- Help Text -->
        <p class="text-center text-sm text-gray-500 pt-2">
          <span class="text-red-500">*</span> Required fields
        </p>
      </form>
    </div>

    <!-- Warning Box -->
    <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-xl p-6">
      <div class="flex items-start space-x-3">
        <i class="fa-solid fa-exclamation-triangle text-yellow-500 text-xl mt-0.5"></i>
        <div>
          <h3 class="font-semibold text-yellow-900 mb-1">Important</h3>
          <p class="text-sm text-yellow-800">
            Make sure all information is accurate. Changes will be visible to all users immediately.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>