<% layout("/layouts/boilerplate") %>

<div class="bg-gradient-to-b from-rose-50 to-white min-h-screen py-8">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Discover Your Perfect Stay
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Explore unique accommodations around the world, from cozy cottages to luxury penthouses
      </p>
    </div>

    <!-- Listings Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <% for(let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="group block">
          <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden transform hover:-translate-y-1">
            <!-- Image Container -->
            <div class="relative h-64 overflow-hidden bg-gray-200">
              <img 
                src="<%= listing.image %>" 
                alt="<%= listing.title %>" 
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute top-4 right-4 bg-white px-3 py-1 rounded-full shadow-md">
                <span class="text-sm font-semibold text-gray-800">₹<%= listing.price.toLocaleString("en-IN") %></span>
              </div>
            </div>
            
            <!-- Content -->
            <div class="p-5">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-rose-500 transition-colors line-clamp-1">
                <%= listing.title %>
              </h3>
              
              <div class="flex items-center text-gray-600 mb-3">
                <i class="fa-solid fa-location-dot text-rose-500 mr-2"></i>
                <span class="text-sm"><%= listing.location %>, <%= listing.country %></span>
              </div>
              
              <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                <span class="text-sm font-medium text-gray-700">
                  <i class="fa-solid fa-home text-gray-400 mr-1"></i> Property
                </span>
                <span class="text-rose-500 font-semibold group-hover:underline">
                  View Details →
                </span>
              </div>
            </div>
          </div>
        </a>
      <% } %>
    </div>

    <!-- Empty State -->
    <% if(allListings.length === 0) { %>
      <div class="text-center py-20">
        <i class="fa-solid fa-home text-6xl text-gray-300 mb-4"></i>
        <h3 class="text-2xl font-semibold text-gray-700 mb-2">No listings available</h3>
        <p class="text-gray-500 mb-6">Be the first to add a listing!</p>
        <a href="/listings/new" class="inline-block px-6 py-3 bg-rose-500 text-white font-medium rounded-lg hover:bg-rose-600 transition-colors">
          Add New Listing
        </a>
      </div>
    <% } %>
  </div>
</div>